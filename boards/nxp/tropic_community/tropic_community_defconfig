CONFIG_DEVICE_CONFIGURATION_DATA=n
CONFIG_CONSOLE=y
CONFIG_UART_CONSOLE=y
CONFIG_SERIAL=y
CONFIG_GPIO=y
CONFIG_SYS_CLOCK_HW_CYCLES_PER_SEC=600000000
CONFIG_ARM_MPU=y
CONFIG_HW_STACK_PROTECTION=y
CONFIG_CRC=y
CONFIG_UART_ASYNC_API=y

# mr_vmu_tropic (same FlexPWM peripheral family) notes a FlexPWM bug that
# triggers a spurious assertion - disabling until confirmed not to apply
# here too, since this board also drives FlexPWM2/3 (LED_G, buzzer).
CONFIG_ASSERT=n
